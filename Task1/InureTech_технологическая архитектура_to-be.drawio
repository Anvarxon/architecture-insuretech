        <mxCell id="db-b" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" value="PostgreSQL HA B&#xa;async replica from A&#xa;promote on disaster" vertex="1">
