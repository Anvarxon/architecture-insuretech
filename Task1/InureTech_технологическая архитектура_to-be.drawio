  <diagram id="insuretech-tech-to-be" name="InureTech технологическая архитектура to-be">
    <mxGraphModel dx="792" dy="432" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" value="InureTech технологическая архитектура to-be&#xa;Цель: доступность 99,9%, RTO 45 мин, RPO 15 мин, равномерная загрузка страниц по регионам РФ" vertex="1">
          <mxGeometry height="70" width="1020" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="clients" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4F8A;strokeColor=#073B68;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="Пользователи B2C&#xa;в регионах РФ" vertex="1">
          <mxGeometry height="70" width="160" x="70" y="130" as="geometry" />
        </mxCell>
        <mxCell id="partners" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E849F;strokeColor=#6F6680;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="B2B-партнеры&lt;br&gt;пользователи API" vertex="1">
          <mxGeometry height="70" width="160" x="70" y="260" as="geometry" />
        </mxCell>
        <mxCell id="dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8E8FC;strokeColor=#6C8EBF;fontSize=12;" value="GeoDNS / Anycast DNS&#xa;active-active routing&#xa;health check HTTPS /healthz" vertex="1">
          <mxGeometry height="90" width="190" x="310" y="150" as="geometry" />
        </mxCell>
        <mxCell id="cdn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" value="CDN edge по РФ&lt;br&gt;статический Web, CSS, JS, имиджи&lt;br&gt;кешированные справочные данные о продукте" vertex="1">
          <mxGeometry height="90" width="210" x="560" y="120" as="geometry" />
        </mxCell>
        <mxCell id="waf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" value="WAF + API Gateway&#xa;TLS termination&#xa;partner auth, rate limiting, quotas" vertex="1">
          <mxGeometry height="90" width="210" x="560" y="250" as="geometry" />
        </mxCell>
        <mxCell id="glb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="Global L7 Load Balancer&lt;br&gt;active-active,&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;взвешенная маршрутизация&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;проверки работоспособности регионального&lt;/span&gt;&amp;nbsp;ingress" vertex="1">
          <mxGeometry height="110" width="230" x="830" y="180" as="geometry" />
        </mxCell>
        <mxCell id="region-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=none;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=12;" value="Площадка A / основной регион&#xa;независимый Kubernetes-кластер, 3 зоны доступности" vertex="1">
          <mxGeometry height="560" width="780" x="70" y="410" as="geometry" />
        </mxCell>
        <mxCell id="region-b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=none;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=12;" value="Площадка B / резервный регион&#xa;независимый Kubernetes-кластер, standby-ready" vertex="1">
          <mxGeometry height="560" width="780" x="910" y="410" as="geometry" />
        </mxCell>
        <mxCell id="ingress-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFE3F4;strokeColor=#0E7DAD;fontSize=12;" value="Ingress Controller A&#xa;readiness/liveness probes&#xa;HPA + PodDisruptionBudget" vertex="1">
          <mxGeometry height="90" width="200" x="120" y="480" as="geometry" />
        </mxCell>
        <mxCell id="k8s-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" value="Managed Kubernetes A&#xa;core-app, client-info, ins-product-aggregator, ins-comp-settlement&#xa;replicas spread across AZs" vertex="1">
          <mxGeometry height="110" width="260" x="370" y="470" as="geometry" />
        </mxCell>
        <mxCell id="db-a" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" value="PostgreSQL HA A&#xa;Patroni primary + sync replicas&#xa;WAL archive every 5 min" vertex="1">
          <mxGeometry height="120" width="270" x="365" y="650" as="geometry" />
        </mxCell>
        <mxCell id="cache-a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="Redis / in-memory кеш&lt;br&gt;католог продукта, сессии, ключи идемпотентности" vertex="1">
          <mxGeometry height="90" width="200" x="120" y="670" as="geometry" />
        </mxCell>
        <mxCell id="backup" parent="1" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="Объектное хранилище&lt;br&gt;ежедневный бекап + PITR WAL&lt;br&gt;retention 35 дней" vertex="1">
          <mxGeometry height="100" width="200" x="610" y="825" as="geometry" />
        </mxCell>
        <mxCell id="ingress-b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFE3F4;strokeColor=#0E7DAD;fontSize=12;" value="Ingress Controller B&#xa;health endpoint /healthz&#xa;traffic after GLB failover" vertex="1">
          <mxGeometry height="90" width="200" x="960" y="470" as="geometry" />
        </mxCell>
        <mxCell id="k8s-b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" value="&lt;div&gt;Управляемый Kubernetes B,&lt;/div&gt;&lt;div&gt;те же манифесты, что и в GitOps,&lt;/div&gt;&lt;div&gt;минимальное количество «горячих» реплик&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="1340" y="460" as="geometry" />
