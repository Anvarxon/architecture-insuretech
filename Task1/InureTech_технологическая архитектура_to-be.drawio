        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="dns" target="waf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="waf" target="glb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="active-active + health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="glb" target="ingress-a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="failover route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="glb" target="ingress-b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="ingress-a" target="k8s-a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="ingress-b" target="k8s-b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="k8s-a" target="db-a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="k8s-b" target="db-b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="sync/async replication, RPO &lt;= 15 min" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B85450;fontSize=11;" edge="1" parent="1" source="db-a" target="db-b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="WAL + backups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B85450;fontSize=11;" edge="1" parent="1" source="db-a" target="backup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="k8s-a" target="insurers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="k8s-a" target="payment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="cache invalidation / static content" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="k8s-a" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell>
