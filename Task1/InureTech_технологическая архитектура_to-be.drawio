        </mxCell>
        <mxCell id="cache-b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="Redis / cache B&#xa;rebuilt from DB/events&#xa;no RPO dependency" vertex="1">
