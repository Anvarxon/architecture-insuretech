<mxfile host="app.diagrams.net" modified="2026-07-04T00:00:00.000Z" agent="Codex" version="24.7.11">
  <diagram id="insuretech-tech-to-be" name="InureTech технологическая архитектура to-be">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="InureTech технологическая архитектура to-be&#xa;Цель: доступность 99,9%, RTO 45 мин, RPO 15 мин, равномерная загрузка страниц по регионам РФ" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1020" height="70" as="geometry" />
        </mxCell>
        <mxCell id="clients" value="Пользователи B2C&#xa;в регионах РФ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B4F8A;strokeColor=#073B68;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="partners" value="B2B-партнеры&#xa;API consumers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E849F;strokeColor=#6F6680;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="GeoDNS / Anycast DNS&#xa;active-active routing&#xa;health check HTTPS /healthz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8E8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="150" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cdn" value="CDN edge по РФ&#xa;статический Web, CSS, JS, images&#xa;cache product reference data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="waf" value="WAF + API Gateway&#xa;TLS termination&#xa;partner auth, rate limiting, quotas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="glb" value="Global L7 Load Balancer&#xa;active-active, weighted routing&#xa;health checks to regional ingress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="180" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="region-a" value="Площадка A / основной регион&#xa;независимый Kubernetes-кластер, 3 зоны доступности" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=none;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="780" height="560" as="geometry" />
        </mxCell>
        <mxCell id="region-b" value="Площадка B / резервный регион&#xa;независимый Kubernetes-кластер, standby-ready" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#666666;fillColor=none;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="410" width="780" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ingress-a" value="Ingress Controller A&#xa;readiness/liveness probes&#xa;HPA + PodDisruptionBudget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFE3F4;strokeColor=#0E7DAD;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k8s-a" value="Managed Kubernetes A&#xa;core-app, client-info, ins-product-aggregator, ins-comp-settlement&#xa;replicas spread across AZs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="470" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db-a" value="PostgreSQL HA A&#xa;Patroni primary + sync replicas&#xa;WAL archive every 5 min" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="365" y="650" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cache-a" value="Redis / in-memory cache&#xa;product catalog, sessions, idempotency keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="670" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="Object Storage&#xa;daily full backup + PITR WAL&#xa;retention 35 days" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="815" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ingress-b" value="Ingress Controller B&#xa;health endpoint /healthz&#xa;traffic after GLB failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFE3F4;strokeColor=#0E7DAD;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="470" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k8s-b" value="Managed Kubernetes B&#xa;same manifests from GitOps&#xa;minimum warm replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="470" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db-b" value="PostgreSQL HA B&#xa;async replica from A&#xa;promote on disaster" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1205" y="650" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cache-b" value="Redis / cache B&#xa;rebuilt from DB/events&#xa;no RPO dependency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="670" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="insurers" value="Страховые компании&#xa;REST / SOAP / GraphQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E849F;strokeColor=#6F6680;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1510" y="210" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="payment" value="Платежный сервис&#xa;redirect / callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E849F;strokeColor=#6F6680;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1510" y="330" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note-scale" value="Стратегия масштабирования: web/core/client-info/aggregator масштабируются горизонтально через HPA/KEDA. Вертикальное масштабирование оставлено для PostgreSQL и кеша как вспомогательная мера." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="820" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note-k8s" value="Почему независимые кластеры: отказ control plane или сетевой связности одной площадки не выводит из строя вторую. GitOps держит одинаковую конфигурацию, GLB выполняет failover." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="820" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note-shard" value="Шардирование БД не применяется: текущий объем 50 GB, RPS умеренный. Достаточно HA, индексов, партиционирования исторических заявок и read replicas. Шардинг оставить как future option при росте до сотен GB/TB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="1010" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="clients" target="dns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="partners" target="dns"><mxGeometry relative="1" as="geometry" /></mxCell>
