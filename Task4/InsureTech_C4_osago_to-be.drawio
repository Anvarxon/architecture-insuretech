        </mxCell>
        <mxCell id="api-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" value="API core-app для Web:&#xa;POST /api/osago/applications - создать заявку&#xa;GET /api/osago/applications/{id}/offers/stream - SSE поток предложений&#xa;POST /api/osago/applications/{id}/select - выбрать предложение" vertex="1">
          <mxGeometry height="125" width="360" x="330" y="780" as="geometry" />
        </mxCell>
        <mxCell id="integration-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" value="API osago-агрегатора для основного приложения: API событий через Kafka. Событие команды содержит идентификатор приложения, идентификатор клиента, автомобиль, драйверы, идентификатор трассировки. Ответные события поступают от одного страховщика и коррелируются по идентификатору приложения." vertex="1">
          <mxGeometry height="125" width="390" x="760" y="780" as="geometry" />
        </mxCell>
        <mxCell id="resilience-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;" value="&lt;div&gt;Модели устойчивости:&lt;/div&gt;&lt;div&gt;SSE веб-ядра: тайм-аут простоя + повторное подключение, привязка не требуется, события доступны через брокер/модель чтения.&lt;/div&gt;&lt;div&gt;основной-брокер: транзакционный исходящий ящик, идемпотентность.&lt;/div&gt;&lt;div&gt;osago-insurers: ограничение ставки на страховщика, автоматический выключатель, повторная попытка с отсрочкой, тайм-аут запроса, крайний срок 60 секунд.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="430" x="1190" y="760" as="geometry" />
        </mxCell>
