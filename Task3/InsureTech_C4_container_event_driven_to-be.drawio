        <mxCell id="e10" value="подписка на product-catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#D79B00;" edge="1" parent="1" source="broker" target="core"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="подписка на product-catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;strokeColor=#D79B00;" edge="1" parent="1" source="broker" target="settlement"><mxGeometry relative="1" as="geometry" /></mxCell>
