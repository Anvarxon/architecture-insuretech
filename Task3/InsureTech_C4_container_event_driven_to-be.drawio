        <mxCell id="e8" value="TCP + исходящий журнал" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="product-agg" target="product-db"><mxGeometry relative="1" as="geometry" /></mxCell>
